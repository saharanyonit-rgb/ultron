# Ultron Environment Variables
# One primary provider for v1 — choose one from the list below.

# === Provider Selection (REQUIRED — choose one) ===
# Set the provider you want to use. Only ONE is active at a time.
# Options: gemini, nvidia, openrouter, grok, openai, azure_openai, anthropic, cohere, mistral, perplexity, bedrock
ULTRON_PROVIDER=gemini

# === Google Gemini ===
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# === NVIDIA ===
# Get a key from: https://build.nvidia.com/api
ULTRON_NVIDIA_API_KEY=your_nvidia_api_key_here

# === OpenRouter (supports many models) ===
# Get a key from: https://openrouter.ai/settings/keys
ULTRON_OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Grok (xAI) ===
# Get a key from: https://console.x.ai/
ULTRON_GROK_API_KEY=your_grok_api_key_here

# === OpenAI ===
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# === Azure OpenAI ===
# Get a key from: https://portal.azure.com -> Azure AI Services
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_VERSION=2024-02-01

# === Anthropic (Claude) ===
# Get a key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Cohere ===
# Get a key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# === Mistral ===
# Get a key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# === Perplexity ===
# Get a key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# === AWS Bedrock ===
# Set up credentials: https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# === System ===
ASSISTANT_NAME=Ultron
LOG_LEVEL=INFO

# === Startup Behavior ===
JARVIS_AUTO_START=true
JARVIS_AUTO_OPEN_UI=true
JARVIS_FULLSCREEN=true
JARVIS_DISPLAY=primary
JARVIS_UI_URL=http://127.0.0.1:8080

# === Wake Word ===
WAKE_WORD_ENABLED=true
WAKE_WORD=hi ultron

# === Double-Clap Wake ===
DOUBLE_CLAP_ENABLED=true
DOUBLE_CLAP_MIN_INTERVAL_MS=100
DOUBLE_CLAP_MAX_INTERVAL_MS=700
DOUBLE_CLAP_COOLDOWN_MS=1500

# === Microphone ===
MICROPHONE_ENABLED=true

# === Model (defaults shown) ===
# For Gemini: gemini-3.5-flash, gemini-2.5-flash, gemini-2.0-flash-exp
# For OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# For Anthropic: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# For NVIDIA: nvidia/nemotron
# For Mistral: mistral-large-latest, mistral-small-latest
# For Perplexity: sonar, sonar-pro, sonar-deepsearch
# For Cohere: command-a, command-r-plus, command-r
ULTRON_MODEL=gemini-3.5-flash

# === Advanced ===
ULTRON_API_BASE_URL=  # Custom endpoint (leave empty to use provider default)
ULTRON_TEMPERATURE=0.3

# === JARVIS Phase 7: Specialized Brain Configuration ===
# Each brain can use a different model and provider
# Provider options: gemini, openrouter, openai, nvidia, anthropic, grok

# Planning Brain - decomposes complex goals into tasks
JARVIS_PLANNER_PROVIDER=gemini
JARVIS_PLANNER_MODEL=gemini-3.5-flash
JARVIS_PLANNER_TEMPERATURE=0.3
JARVIS_PLANNER_MAX_TOKENS=8192

# Research Brain - gathers information and analyzes sources
JARVIS_RESEARCH_PROVIDER=gemini
JARVIS_RESEARCH_MODEL=gemini-3.5-flash
JARVIS_RESEARCH_TEMPERATURE=0.3
JARVIS_RESEARCH_MAX_TOKENS=8192

# Coding Brain - analyzes code and implements features
JARVIS_CODING_PROVIDER=gemini
JARVIS_CODING_MODEL=gemini-3.5-flash
JARVIS_CODING_TEMPERATURE=0.3
JARVIS_CODING_MAX_TOKENS=8192

# Computer Brain - controls browser and desktop applications
JARVIS_COMPUTER_PROVIDER=gemini
JARVIS_COMPUTER_MODEL=gemini-3.5-flash
JARVIS_COMPUTER_TEMPERATURE=0.3
JARVIS_COMPUTER_MAX_TOKENS=8192

# Verification Brain - independently verifies task results
JARVIS_VERIFICATION_PROVIDER=gemini
JARVIS_VERIFICATION_MODEL=gemini-3.5-flash
JARVIS_VERIFICATION_TEMPERATURE=0.3
JARVIS_VERIFICATION_MAX_TOKENS=8192

# Fast Model - for simple conversational requests
JARVIS_FAST_PROVIDER=gemini
JARVIS_FAST_MODEL=gemini-3.5-flash
JARVIS_FAST_TEMPERATURE=0.3
JARVIS_FAST_MAX_TOKENS=4096
